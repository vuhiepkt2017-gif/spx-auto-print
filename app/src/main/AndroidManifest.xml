<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Quyền truy cập Internet để gửi dữ liệu lên Google Sheets -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Quyền sử dụng Camera để quét mã vận đơn và OCR -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Quyền Rung để phản hồi khi quét thành công -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Quyền hiển thị thông báo Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Quyền chạy dịch vụ chạy nền (Foreground Service) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="Hỗ trợ vận hành"
        android:icon="@drawable/app_logo"
        android:roundIcon="@drawable/app_logo"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">

        <!-- Tự động tải mô hình OCR và Barcode từ Google Play Services khi cài đặt app -->
        <meta-data
            android:name="com.google.mlkit.vision.dependencies"
            android:value="barcode,ocr" />

        <activity
            android:name="com.VTDStadio.Hotroin.MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Khai báo Foreground Service cho thông báo đẩy -->
        <service
            android:name="com.VTDStadio.Hotroin.BackgroundNotificationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
